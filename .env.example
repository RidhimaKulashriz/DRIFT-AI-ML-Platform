# =============================================================================
# DRIFT Platform Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# --- Backend ---
NODE_ENV=development
PORT=3000

# --- Database (PostgreSQL for Drizzle ORM) ---
DATABASE_URL=postgresql://user:password@localhost:5432/drift

# --- Supabase (for auth + storage) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- ML Inference ---
ML_INFERENCE_URL=http://localhost:8000/predict
ML_INFERENCE_TOKEN=replace-with-private-service-token
ROBOFLOW_API_KEY=replace-with-rotated-roboflow-key
ROAD_DAMAGE_MODEL_ID=road-damage-detection-v2-xg6by/3

# --- Email Delivery (choose one) ---
# Option 1: Webhook relay (e.g., Zapier, Make, n8n)
DRIFT_EMAIL_WEBHOOK_URL=https://your-webhook-url.com/drift-email
# Option 2: SMTP relay service
DRIFT_SMTP_URL=http://localhost:5000
# Option 3: direct SMTP (Gmail requires an app password)
DRIFT_SMTP_HOST=smtp.gmail.com
DRIFT_SMTP_PORT=465
DRIFT_SMTP_SECURE=true
DRIFT_SMTP_USER=sender@example.com
DRIFT_SMTP_PASS=app-password

# --- Hardware Bridge (Drone Integration) ---
# For DJI Mini 3 Pro → Laptop → Backend connection
DRIFT_HARDWARE_ENDPOINT=http://localhost:4000/bridge
DRIFT_INGEST_TOKEN=replace-with-private-bridge-token
DRIFT_MEDIA_DIR=./drift-media-inbox
DRIFT_MISSION_ID=123
DRIFT_ASSET_ID=1
DRIFT_ASSET_CRITICALITY=3

# --- Google Maps ---
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-key

# --- Frontend ---
VITE_BACKEND_URL=http://localhost:3000
# Browser-visible HLS stream. For local testing use MediaMTX; deployed frontends require a public HTTPS HLS URL.
VITE_DRIFT_LIVE_STREAM_URL=http://127.0.0.1:8888/drift-annotated/index.m3u8
# Optional: publish ML-annotated frames from main_app2.py to MediaMTX.
DRIFT_ANNOTATED_RTMP_URL=rtmp://127.0.0.1:1935/drift-annotated
