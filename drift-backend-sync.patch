+/**
+ * Blend live backend state (real defects + real telemetry for the active mission)
+ * into the geometry-derived model, and report whether this tab is actually
+ * synced to backend truth right now or only showing the offline demo geometry model.
+ */
+function applyBackendSync(mode: MissionMode, base: ReturnType<typeof computeModel>, liveDefects: LiveDefectRow[], liveTelemetry: LiveTelemetryRow[]) {
+  if (!liveDefects.length && !liveTelemetry.length) {
+    return { ...base, liveSynced: false, liveDefectCount: 0, liveCriticalCount: 0, latestBatteryPercent: null as number | null, latestTelemetryAt: null as string | null };
+  }
+  const criticalCount = liveDefects.filter(defect => defect.severity === "critical" || defect.severity === "high").length;
+  const latestBattery = liveTelemetry[0]?.batteryPercent ?? null;
+  const latestTelemetryAt = liveTelemetry[0]?.capturedAt ? new Date(liveTelemetry[0].capturedAt as string).toISOString() : null;
+  const metrics = { ...base.metrics };
+  if (mode === "disaster") { metrics.affected = Math.max(metrics.affected, liveDefects.length); metrics.cascade = clamp(Math.round(metrics.cascade + criticalCount * 12)); }
+  if (mode === "construction") { metrics.variance = Math.max(metrics.variance, criticalCount); if (latestBattery !== null) metrics.completion = clamp(Math.round((metrics.completion + latestBattery) / 2)); }
+  if (mode === "border") { metrics.change = Math.max(metrics.change, criticalCount); }
+  if (mode === "urban") { metrics.gap = Math.max(1, metrics.gap - Math.round(liveDefects.length / 2)); }
+  if (mode === "military") { metrics.conflicts = Math.max(metrics.conflicts, criticalCount); if (latestBattery !== null) metrics.battery = latestBattery; }
+  return { ...base, metrics, liveSynced: true, liveDefectCount: liveDefects.length, liveCriticalCount: criticalCount, latestBatteryPercent: latestBattery, latestTelemetryAt };
+}
