# Local reconstruction stack defaults.
# The application server and worker must use the same DATABASE_URL and artifact root.
DATABASE_URL=postgresql://drift:drift@localhost:5432/drift
RECONSTRUCTION_ARTIFACT_ROOT=/absolute/path/to/DRIFT-AI-ML-Platform/data/reconstruction
RECONSTRUCTION_POLL_SECONDS=10
ODM_IMAGE=opendronemap/odm:latest
ODM_MAX_CONCURRENCY=4
RECONSTRUCTION_MAX_FRAMES=900
RECONSTRUCTION_ODM_TIMEOUT_SECONDS=5400
# Optional: a real detector command. Leave unset for zero detections.
# DRIFT_DETECTION_COMMAND=/app/detect.sh
