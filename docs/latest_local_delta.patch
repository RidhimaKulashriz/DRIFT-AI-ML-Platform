[31m-        └─────────────────────────────────────────────────────────────┘[m
[31m-      </p>[m
[31m-    </div>[m
[31m-[m
[31m-    <h3>The Streamlit app structure</h3>[m
[31m-    <div class="codeblock">[m
[31m-<span class="cc"># dashboard/app.py</span>[m
